{
	"name": "mr-starter-kit",
	"description": "A modern monorepo starter kit configured with best practices for JavaScript/TypeScript development.",
	"author": "Jonathan Debétaz",
	"private": true,
	"license": "UNLICENSED",
	"repository": "https://github.com/jdebetaz/mr-starter-kit",
	"type": "module",
	"scripts": {
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"scaffold": "node bin/scaffold.mjs",
		"release": "node bin/release.mjs",
		"release:rewrite": "node bin/rewrite-release.mjs",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"prepare": "husky",
		"taze": "pnpm dlx taze -r -I --maturity-period 3",
		"typecheck": "pnpm -r --parallel run typecheck",
		"test": "pnpm -r --parallel run test",
		"test:lint": "node --test tools/oxlint/tenkai/rules/*.test.mjs"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@openrouter/sdk": "^1.5.11",
		"@oxlint/plugins": "^1.90.0",
		"commander": "^15.0.0",
		"dotenv": "^18.0.9",
		"eslint": "^9.39.5",
		"husky": "^9.1.7",
		"markdownlint": "^0.42.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"packageManager": "pnpm@12.16.0"
}
