{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: ['config:recommended', 'schedule:weekly', 'group:allNonMajor'],
	labels: ['dependencies'],
	rangeStrategy: 'bump',
	// implied by default, pinned so renovate/* branches never pile up
	pruneStaleBranches: true,
	packageRules: [
		{
			matchDepTypes: ['peerDependencies'],
			enabled: false,
		},
	],
	ignoreDeps: [
		// manually bumping
		'node',
		'@types/node',
		'postgres',
	],
}
