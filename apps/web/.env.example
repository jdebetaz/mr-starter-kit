# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
APP_NAME=web
APP_VERSION=0.0.0
APP_ENV=development

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=app

# Telemetry
# Base OTLP/HTTP endpoint of your collector. Leave it empty to keep
# OpenTelemetry off; signal paths (/v1/traces, /v1/metrics, /v1/logs) are
# appended automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Credentials for a hosted backend, read directly by the OTLP exporters.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20token
# Sample a fraction of the traces instead of all of them.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# Mail
# SMTP_HOST/SMTP_PORT default to the Mailpit service in docker-compose.yml, whose
# inbox is at http://localhost:8025 and which never forwards off your machine.
MAIL_MAILER=smtp
MAIL_FROM_NAME=${APP_NAME}
MAIL_FROM_ADDRESS=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
