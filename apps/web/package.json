{
  "name": "@boilerplate/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json"
  },
  "imports": {
    "#app/*": "./app/*.js",
    "#core/*": "./src/core/*.js",
    "#identity/*": "./src/identity/*.js",
    "#shared/*": "./src/shared/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#types/*": "./types/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "catalog:",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@tailwindcss/vite": "catalog:",
    "@types/luxon": "^3.7.6",
    "@types/mjml": "^5.4.2",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/ace": "^14.1.1",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^5.0.5",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/otel": "^1.2.4",
    "@adonisjs/queue": "^0.7.0",
    "@adonisjs/redis": "^11.0.0",
    "@adonisjs/session": "^8.3.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.4",
    "@boilerplate/design-system": "workspace:*",
    "@boilerplate/validation": "workspace:*",
    "@inertiajs/core": "^3.9.1",
    "@inertiajs/react": "^3.9.1",
    "@tuyau/core": "catalog:",
    "@vinejs/vine": "^4.4.0",
    "axios": "^1.21.0",
    "better-sqlite3": "^13.0.3",
    "disposable-email-domains-js": "^1.26.0",
    "edge.js": "^6.5.1",
    "luxon": "^3.7.2",
    "mjml": "^5.4.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.8",
    "uuid": "^14.0.3"
  },
  "hotHook": {
    "boundaries": [
      "./app/*/controllers/**/*.ts",
      "./app/*/middleware/*.ts"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react>eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config"
}
