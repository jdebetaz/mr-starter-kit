{
  "name": "@boilerplate/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json"
  },
  "imports": {
    "#app/*": "./app/*.js",
    "#identity/*": "./app/identity/*.js",
    "#core/*": "./app/core/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "catalog:",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^10.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.5.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.1",
    "@inertiajs/react": "^3.7.0",
    "@boilerplate/design-system": "workspace:*",
    "@tuyau/core": "catalog:",
    "@vinejs/vine": "^4.4.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "edge.js": "^6.5.1",
    "luxon": "^3.7.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.8",
    "uuid": "^14.0.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react>eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config"
}
