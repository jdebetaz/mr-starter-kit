# Node
TZ=UTC
PORT=3334
HOST=localhost
NODE_ENV=test

# App
LOG_LEVEL=silent
APP_KEY=testtesttesttesttesttesttesttest
APP_URL=http://${HOST}:${PORT}
APP_NAME=web
APP_VERSION=0.0.0
APP_ENV=development

# Session
SESSION_DRIVER=memory

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=app_test

# Mail
# Deliberately empty: leaving MAIL_* unset is what proves a fresh clone boots
# with no mail account. Nothing is sent in tests — the mailer is faked globally
# in tests/bootstrap.ts.
