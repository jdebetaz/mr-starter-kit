# Node
TZ=UTC
PORT=3334
HOST=localhost
NODE_ENV=test

# App
LOG_LEVEL=silent
APP_KEY=testtesttesttesttesttesttesttest
APP_URL=http://${HOST}:${PORT}
APP_NAME=web
APP_VERSION=0.0.0
APP_ENV=development

# Session
SESSION_DRIVER=memory

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=app_test

# Mail
# Required since `node ace configure @adonisjs/mail` added them to the env schema.
# Nothing is sent: the mailer is faked for every suite in tests/bootstrap.ts.
MAIL_MAILER=smtp
MAIL_FROM_NAME=web
MAIL_FROM_ADDRESS=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025

# Queue
# `sync` runs a dispatched job inline, so the suite needs no Redis and no
# worker, and a test sees the job's effect without waiting.
QUEUE_DRIVER=sync
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
