{
	"name": {{ project_slug | tojson }},
	"description": {{ project_description | tojson }},
	"author": {{ author_name | tojson }},
	"private": true,
	"license": {{ license | tojson }},
	"type": "module",
	"scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
		"prepare": "husky",
    "taze": "pnpm dlx taze -r -I --maturity-period 3",
		"typecheck": "pnpm -r --parallel run typecheck"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"husky": "^9.1.7",
    "@oxlint/plugins": "1.78.0",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"packageManager": "pnpm@11.16.0"
}
